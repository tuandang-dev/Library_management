<div class="catalog-page pb-5">
    <div class="catalog-header mb-4">
        <h1 class="catalog-header__title">Book Catalog</h1>
        <p class="catalog-header__desc">Browse and add books to your cart</p>
    </div>

    <div class="search-panel mb-4">
        <form class="d-flex flex-wrap gap-3 align-items-center" action="/book" method="GET">
            <div class="search-wrap flex-grow-1">
                <i class="fa-solid fa-magnifying-glass"></i>
                <input class="search-input" type="text" name="searchbook" value="{{keyword}}"
                    placeholder="Search by title, author, ISBN..." />
            </div>

            <select class="filter-select" id="categorySelect" name="category" onchange="this.form.submit()">
                <option value="">All Categories</option>
                {{#each categories}}
                <option value="{{this._id}}">{{this.name}}</option>
                {{/each}}
            </select>

            <select class="filter-select" id="statusSelect" name="status" onchange="this.form.submit()">
                <option value="">All Status</option>
                <option value="avaiable">Available</option>
                <option value="borrow">Borrowed</option>
            </select>
        </form>
    </div>

    <div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-3">
        <div class="d-flex align-items-center gap-3">
            <div class="results-icon-box">
                <i class="fa-solid fa-book-open"></i>
            </div>
            <div>
                <p class="results-title">
                    {{#if books.length}}{{books.length}}{{else}}0{{/if}} Books Found
                </p>
                <p class="results-sub">
                    Total collection: {{#if countDocuments}}{{countDocuments}}{{else}}0{{/if}} books
                </p>
            </div>
        </div>

        <div class="d-flex align-items-center gap-2 flex-wrap">
            <span class="stat-chip avail">
                Available: {{#if availableQuantityTotal}}{{availableQuantityTotal}}{{else}}0{{/if}}
            </span>
            <button type="button" class="btn-cart-summary" id="openCartBtn" title="Xem giỏ sách">
                <i class="fa-solid fa-cart-shopping me-1"></i>
                <span id="cartCountBadge">0 in cart</span>
            </button>
        </div>
    </div>

    {{#if books.length}}
    <div class="books-grid mb-4">
        {{#each books}}
        <div class="book-card" data-id="{{this._id}}" data-in-cart="{{#if this.isInCart}}true{{else}}false{{/if}}"
            data-title="{{this.title}}" data-author="{{this.author}}" data-image="{{this.image}}"
            data-accession-number="{{this.accessionNumber}}" data-category="{{this.categoryId.name}}"
            data-isbn="{{this.isbn}}" data-total-quantity="{{this.totalQuantity}}"
            data-available-quantity="{{this.availableQuantity}}"
            data-location="{{#if this.location}}{{this.location}}{{else}}Section A, Shelf 2{{/if}}"
            data-description="{{#if this.description}}{{this.description}}{{else}}A comprehensive introduction to computer science fundamentals.{{/if}}">
            <div class="book-img-wrap">
                <img src="{{this.image}}" alt="{{this.title}}" />
                {{#if this.availableQuantity}}
                <span class="badge-copies">{{this.availableQuantity}} left</span>
                <span class="badge-status available">available</span>
                {{else}}
                <span class="badge-status borrowed">borrowed</span>
                {{/if}}

                {{#if this.isInCart}}
                <span class="badge-in-cart">In Cart</span>
                {{/if}}
            </div>
            <div class="book-info">
                <p class="book-title" title="{{this.title}}">{{this.title}}</p>
                <p class="book-author">by {{this.author}}</p>
                <span class="book-cat">{{this.categoryId.name}}</span>
            </div>
        </div>
        {{/each}}
    </div>
    {{else}}
    <div class="empty-card my-5">
        <div class="empty-icon-wrap">
            <i class="fa-solid fa-book-open"></i>
        </div>
        <p class="empty-title">No books found</p>
        <p class="empty-sub">Try adjusting your search criteria or browse all categories</p>
    </div>
    {{/if}}
</div>

<dialog id="bookDialog" class="book-modal">
    <div class="book-modal__header">
        <button id="closeDialogBtn" class="book-modal__close-btn" type="button" aria-label="Close dialog">
            <i class="fa-solid fa-xmark"></i>
        </button>
        <div class="book-modal__header-content">
            <div class="book-modal__thumb">
                <img src="" alt="Book Cover" class="book-modal__thumb-img dialog-image" />
            </div>
            <div class="book-modal__header-info">
                <span class="book-modal__header-badge dialog-badge-status">available</span>
                <h2 class="book-modal__title dialog-title">Book Title</h2>
                <p class="book-modal__author">by <span class="dialog-author">Author</span></p>
            </div>
        </div>
    </div>

    <div class="book-modal__body">
        <div class="book-modal__stats-row">
            <div class="book-modal__stat-card">
                <span class="book-modal__stat-label">Availability</span>
                <p class="book-modal__stat-value dialog-availability">0 of 0</p>
                <span class="book-modal__stat-sub">copies available</span>
            </div>
            <div class="book-modal__stat-card">
                <span class="book-modal__stat-label">Location</span>
                <p class="book-modal__stat-value dialog-location">Section A, Shelf 2</p>
                <span class="book-modal__stat-sub">in library</span>
            </div>
        </div>

        <div class="book-modal__info-card">
            <h3 class="book-modal__section-title">Book Information</h3>
            <div class="book-modal__info-list">
                <div class="book-modal__info-item">
                    <span class="book-modal__info-key">Book ID:</span>
                    <span class="book-modal__info-val dialog-book-id">-</span>
                </div>
                <div class="book-modal__info-item">
                    <span class="book-modal__info-key">ISBN:</span>
                    <span class="book-modal__info-val dialog-isbn">-</span>
                </div>
                <div class="book-modal__info-item">
                    <span class="book-modal__info-key">Category:</span>
                    <span class="book-modal__info-val dialog-category">-</span>
                </div>
            </div>
        </div>

        <div class="book-modal__notice-card" id="dialogNextAvailableBox">
            <div class="book-modal__notice-icon">
                <i class="fa-regular fa-calendar-check"></i>
            </div>
            <div class="book-modal__notice-content">
                <span class="book-modal__notice-title">Next Available</span>
                <span class="book-modal__notice-date dialog-next-date">Jan 25, 2025</span>
            </div>
        </div>

        <div class="book-modal__desc-card">
            <span class="book-modal__desc-label">Description</span>
            <p class="book-modal__desc-text dialog-description">
                Book description...
            </p>
        </div>
    </div>
    <button type="button" class="book-modal__btn-add-cart" id="dialogAddToCartBtn">
        <i class="fa-solid fa-cart-shopping"></i>
        <span>Add to Cart</span>
    </button>
</dialog>

<script>
    document.addEventListener('DOMContentLoaded', () => {
        const urlParams = new URLSearchParams(window.location.search);
        const categoryId = urlParams.get('category');
        const status = urlParams.get('status');

        if (categoryId) {
            const selectCategory = document.getElementById('categorySelect');
            if (selectCategory) selectCategory.value = categoryId;
        }

        if (status) {
            const selectStatus = document.getElementById('statusSelect');
            if (selectStatus) selectStatus.value = status;
        }

        const cartCountBadge = document.getElementById('cartCountBadge');
        const headerCartBadge = document.getElementById('headerCartBadge');

        function updateCartBadgeUI(count) {
            if (cartCountBadge) {
                cartCountBadge.textContent = `${count} in cart`;
            }
            if (headerCartBadge) {
                if (count > 0) {
                    headerCartBadge.textContent = count;
                    headerCartBadge.style.display = 'flex';
                } else {
                    headerCartBadge.style.display = 'none';
                }
            }
        }

        async function syncCartCount() {
            try {
                const res = await fetch('/cart/count');
                const data = await res.json();
                if (data.success) {
                    updateCartBadgeUI(data.cartCount);
                }
            } catch (err) {
                console.error('Không thể lấy số lượng giỏ hàng:', err);
            }
        }
        syncCartCount();

        const openCartBtn = document.getElementById('openCartBtn');
        if (openCartBtn) {
            openCartBtn.addEventListener('click', () => {
                window.location.href = '/cart';
            });
        }

        const dialog = document.getElementById('bookDialog');
        const bookCards = document.querySelectorAll('.book-card');
        const closeBtn = document.getElementById('closeDialogBtn');

        const dialogNextAvailableBox = document.getElementById('dialogNextAvailableBox');
        const dialogAddToCartBtn = document.getElementById('dialogAddToCartBtn');
        const dialogAvailability = document.querySelector('.dialog-availability');
        const badgeStatus = document.querySelector('.dialog-badge-status');

        bookCards.forEach((card) => {
            card.addEventListener('click', () => {
                const bookId = card.dataset.id || '';
                const title = card.dataset.title || 'Untitled';
                const author = card.dataset.author || 'Unknown';
                const image = card.dataset.image || '';
                const accessionNumber = card.dataset.accessionNumber || card.dataset.id || '-';
                const category = card.dataset.category || 'General';
                const isbn = card.dataset.isbn || '-';
                const totalQuantity = parseInt(card.dataset.totalQuantity || '0', 10);
                const availableQuantity = parseInt(card.dataset.availableQuantity || '0', 10);
                const location = card.dataset.location || 'Section A, Shelf 2';
                const description = card.dataset.description || 'A comprehensive introduction to computer science fundamentals.';
                const isInCart = card.dataset.inCart === 'true';

                document.querySelector('.dialog-title').textContent = title;
                document.querySelector('.dialog-author').textContent = author;
                document.querySelector('.dialog-image').src = image;
                document.querySelector('.dialog-location').textContent = location;
                document.querySelector('.dialog-book-id').textContent = accessionNumber;
                document.querySelector('.dialog-isbn').textContent = isbn;
                document.querySelector('.dialog-category').textContent = category;
                document.querySelector('.dialog-description').textContent = description;
                dialogAvailability.textContent = `${availableQuantity} of ${totalQuantity}`;

                if (dialogAddToCartBtn) {
                    dialogAddToCartBtn.dataset.bookId = bookId;
                }

                if (isInCart) {
                    badgeStatus.textContent = 'available';
                    badgeStatus.className = 'book-modal__header-badge book-modal__header-badge--available';
                    dialogAvailability.className = 'book-modal__stat-value book-modal__stat-value--available dialog-availability';

                    if (dialogAddToCartBtn) {
                        dialogAddToCartBtn.style.display = 'flex';
                        dialogAddToCartBtn.disabled = true;
                        dialogAddToCartBtn.classList.add('book-modal__btn-add-cart--in-cart');
                        dialogAddToCartBtn.innerHTML = '<i class="fa-solid fa-check me-1"></i><span>Already in Cart</span>';
                    }
                    if (dialogNextAvailableBox) dialogNextAvailableBox.style.display = 'none';
                } else if (availableQuantity > 0) {
                    badgeStatus.textContent = 'available';
                    badgeStatus.className = 'book-modal__header-badge book-modal__header-badge--available';
                    dialogAvailability.className = 'book-modal__stat-value book-modal__stat-value--available dialog-availability';

                    if (dialogAddToCartBtn) {
                        dialogAddToCartBtn.style.display = 'flex';
                        dialogAddToCartBtn.disabled = false;
                        dialogAddToCartBtn.classList.remove('book-modal__btn-add-cart--in-cart');
                        dialogAddToCartBtn.innerHTML = '<i class="fa-solid fa-cart-shopping"></i><span>Add to Cart</span>';
                    }
                    if (dialogNextAvailableBox) dialogNextAvailableBox.style.display = 'none';
                } else {
                    badgeStatus.textContent = 'borrowed';
                    badgeStatus.className = 'book-modal__header-badge book-modal__header-badge--borrowed';
                    dialogAvailability.className = 'book-modal__stat-value book-modal__stat-value--unavailable dialog-availability';

                    if (dialogAddToCartBtn) dialogAddToCartBtn.style.display = 'none';
                    if (dialogNextAvailableBox) {
                        dialogNextAvailableBox.style.display = 'flex';
                        const nextDate = new Date();
                        nextDate.setDate(nextDate.getDate() + 7);
                        document.querySelector('.dialog-next-date').textContent = nextDate.toLocaleDateString('en-US', {
                            month: 'short',
                            day: 'numeric',
                            year: 'numeric',
                        });
                    }
                }

                dialog.showModal();
            });
        });

        if (closeBtn) {
            closeBtn.addEventListener('click', () => dialog.close());
        }

        if (dialog) {
            dialog.addEventListener('click', (e) => {
                const rect = dialog.getBoundingClientRect();
                if (
                    e.clientX < rect.left ||
                    e.clientX > rect.right ||
                    e.clientY < rect.top ||
                    e.clientY > rect.bottom
                ) {
                    dialog.close();
                }
            });
        }

        if (dialogAddToCartBtn) {
            dialogAddToCartBtn.addEventListener('click', async (e) => {
                e.preventDefault();
                const bookId = dialogAddToCartBtn.dataset.bookId;

                if (!bookId) {
                    alert('Không tìm thấy thông tin sách!');
                    return;
                }

                try {
                    dialogAddToCartBtn.disabled = true;
                    dialogAddToCartBtn.innerHTML = '<i class="fa-solid fa-spinner fa-spin"></i><span>Adding...</span>';

                    const response = await fetch('/cart/add', {
                        method: 'POST',
                        headers: {
                            'Content-Type': 'application/json',
                        },
                        body: JSON.stringify({ bookId }),
                    });

                    const data = await response.json();

                    if (data.success) {
                        updateCartBadgeUI(data.cartCount);

                        const activeCard = document.querySelector(`.book-card[data-id="${bookId}"]`);
                        if (activeCard) {
                            activeCard.dataset.inCart = 'true';
                            const imgWrap = activeCard.querySelector('.book-img-wrap');
                            if (imgWrap && !imgWrap.querySelector('.badge-in-cart')) {
                                const inCartBadge = document.createElement('span');
                                inCartBadge.className = 'badge-in-cart';
                                inCartBadge.textContent = 'In Cart';
                                imgWrap.appendChild(inCartBadge);
                            }
                        }

                        dialog.close();
                        alert(data.message || 'Đã thêm sách vào giỏ mượn thành công!');
                    } else {
                        alert(data.message || 'Không thể thêm sách vào giỏ!');
                    }
                } catch (err) {
                    console.error('Lỗi khi thêm sách vào giỏ:', err);
                    alert('Có lỗi xảy ra khi kết nối máy chủ!');
                } finally {
                    dialogAddToCartBtn.disabled = false;
                    dialogAddToCartBtn.innerHTML = '<i class="fa-solid fa-cart-shopping"></i><span>Add to Cart</span>';
                }
            });
        }
    });
</script>