<main class="auth-page">
    <div class="card auth-card">
        <div class="card__header auth-card__header">
            <img src="/img/logo-small.png" alt="LMS Logo" class="auth-card__logo">
            <h1 class="auth-card__title">Set New Password</h1>
            <p class="auth-card__subtitle">Enter your new password</p>
        </div>

        <div class="card__body">
            <form action="/reset-password/{{token}}" method="POST" class="auth-form">
                {{> input type="password" id="password" name="password" label="New Password"
                placeholder="Enter new password" required=true }}
                {{> input type="password" id="confirmPassword" name="confirmPassword" label="Confirm New Password"
                placeholder="Confirm new password" required=true }}

                {{#if errorMessage}}
                <div>{{errorMessage}}</div>
                {{/if}}

                {{> button type="submit" text="Update Password" modifier="btn--primary btn--block" }}
            </form>
        </div>
    </div>

    {{{footer}}}
</main>