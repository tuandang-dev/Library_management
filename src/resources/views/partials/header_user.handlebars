<header class="user-header">
    <div class="">
        <div class="user-header__top px-4">
            <a href="/" class="user-header__brand">
                <div class="">
                    <img src="/img/logo-small.png" class="auth-footer__logo" alt="Logo">
                </div>
                <div class="user-header__brand-text">
                    <span class="user-header__title">UCC Library</span>
                    <span class="user-header__subtitle">{{#if isAdmin}}Admin Portal{{else}}Student Portal{{/if}}</span>
                </div>
            </a>

            <div class="user-header__meta">
                <div class="user-header__actions">
                    {{#unless isAdmin}}
                    <a href="/cart" class="user-header__icon-btn" title="Giỏ sách">
                        <i class="fa-solid fa-bag-shopping"></i>
                        <span class="user-header__cart-badge" id="headerCartBadge" {{#unless
                            cartCount}}style="display: none;" {{/unless}}>
                            {{#if cartCount}}{{cartCount}}{{else}}0{{/if}}
                        </span>
                    </a>
                    {{/unless}}

                    <div class="user-header__profile-menu" id="userProfileMenu">
                        <div class="user-header__profile" id="userProfileTrigger" tabindex="0" role="button"
                            aria-haspopup="true" aria-expanded="false">
                            <div class="user-header__icon-btn" title="Cài đặt">
                                <i class="fa-solid fa-gear"></i>
                            </div>
                        </div>

                        <div class="user-dropdown" id="userProfileDropdown">
                            <div class="user-dropdown__header">
                                <div class="user-dropdown__avatar">
                                    {{#if user.avatar}}
                                    <img src="{{user.avatar}}" alt="Avatar" class="user-dropdown__avatar-img">
                                    {{else}}
                                    <span class="user-dropdown__avatar-char">A</span>
                                    {{/if}}
                                </div>
                                <div class="user-dropdown__info">
                                    <span class="user-dropdown__name">{{#if user.fullname}}{{user.fullname}}{{else}}Alex
                                        Johnson{{/if}}</span>
                                    <span class="user-dropdown__email"
                                        title="{{#if user.email}}{{user.email}}{{else}}alex.johnson@student.university.edu{{/if}}">
                                        {{#if
                                        user.email}}{{user.email}}{{else}}alex.johnson@student.university.edu{{/if}}
                                    </span>
                                </div>
                            </div>

                            <div class="user-dropdown__divider"></div>

                            <ul class="user-dropdown__list">
                                <li class="user-dropdown__item">
                                    <a href="/profile" class="user-dropdown__link">
                                        <i class="fa-regular fa-user"></i>
                                        <span>Manage Profile</span>
                                    </a>
                                </li>
                                <li class="user-dropdown__item">
                                    <a href="/logout" class="user-dropdown__link user-dropdown__link--danger">
                                        <i class="fa-solid fa-arrow-right-from-bracket"></i>
                                        <span>Logout</span>
                                    </a>
                                </li>
                            </ul>
                        </div>
                    </div>
                </div>

                <div class="user-header__profile">
                    <div class="user-header__details">
                        <span class="user-header__name">{{#if user.fullname}}{{user.fullname}}{{else}}Alex
                            Johnson{{/if}}</span>
                        <span class="user-header__email">{{#if
                            user.email}}{{user.email}}{{else}}alex.johnson@student.university.edu{{/if}}</span>
                    </div>
                    <div class="user-header__avatar">
                        {{#if user.avatar}}
                        <img src="{{user.avatar}}" alt="Avatar" class="user-header__avatar-img">
                        {{else}}
                        <span class="user-header__avatar-char">A</span>
                        {{/if}}
                    </div>
                </div>
            </div>
        </div>

        <nav class="user-header__nav px-4">
            <ul class="user-header__nav-list">
                <li class="user-header__nav-item">
                    <a href="{{#if isAdmin}}/admin/dashboard{{else}}/{{/if}}"
                        class="user-header__nav-link {{#if isHomePage}}user-header__nav-link--active{{/if}}">
                        <i class="fa-solid fa-house"></i>
                        <span>Home</span>
                    </a>
                </li>
                <li class="user-header__nav-item">
                    <a href="{{#if isAdmin}}/admin/attendance{{else}}/attendance{{/if}}"
                        class="user-header__nav-link {{#if isAttendancePage}}user-header__nav-link--active{{/if}}">
                        <i class="fa-solid fa-user-check"></i>
                        <span>Attendance</span>
                    </a>
                </li>
                <li class="user-header__nav-item">
                    <a href="{{#if isAdmin}}/admin/books{{else}}/book{{/if}}"
                        class="user-header__nav-link {{#if isBooksPage}}user-header__nav-link--active{{/if}}">
                        <i class="fa-solid fa-book-open"></i>
                        <span>Books</span>
                    </a>
                </li>
                <li class="user-header__nav-item">
                    <a href="{{#if isAdmin}}/admin/history{{else}}/history{{/if}}"
                        class="user-header__nav-link {{#if isHistoryPage}}user-header__nav-link--active{{/if}}">
                        <i class="fa-solid fa-clock-rotate-left"></i>
                        <span>History</span>
                    </a>
                </li>
                <li class="user-header__nav-item">
                    <a href="{{#if isAdmin}}/admin/scanner{{else}}/scanner{{/if}}"
                        class="user-header__nav-link {{#if isScannerPage}}user-header__nav-link--active{{/if}}">
                        <i class="fa-solid fa-qrcode"></i>
                        <span>QR Scanner</span>
                    </a>
                </li>
            </ul>
        </nav>
    </div>
</header>

<script>
    document.addEventListener('DOMContentLoaded', function () {
        const trigger = document.getElementById('userProfileTrigger');
        const dropdown = document.getElementById('userProfileDropdown');

        if (trigger && dropdown) {
            trigger.addEventListener('click', function (e) {
                e.stopPropagation();
                dropdown.classList.toggle('user-dropdown--show');
                const isExpanded = dropdown.classList.contains('user-dropdown--show');
                trigger.setAttribute('aria-expanded', isExpanded);
            });

            document.addEventListener('click', function (e) {
                if (!dropdown.contains(e.target) && !trigger.contains(e.target)) {
                    dropdown.classList.remove('user-dropdown--show');
                    trigger.setAttribute('aria-expanded', 'false');
                }
            });

            document.addEventListener('keydown', function (e) {
                if (e.key === 'Escape') {
                    dropdown.classList.remove('user-dropdown--show');
                    trigger.setAttribute('aria-expanded', 'false');
                }
            });
        }
    });
</script>