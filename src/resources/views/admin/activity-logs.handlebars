<div class="activity-logs">
    <div>
        <div class="activity-logs__header mb-4">
            <h1 class="activity-logs__title d-flex align-items-center mb-1">
                <i class="fa-solid fa-chart-line activity-logs__title-icon mr-2"></i>
                Global Activity Logs
            </h1>
            <p class="activity-logs__subtitle mb-0">
                Comprehensive monitoring of all system activities and user actions across the platform.
            </p>
        </div>

        <div class="activity-logs__metrics mb-4">
            <div class="row">
                <div class="col-xl-2 col-lg-4 col-md-4 col-sm-6 mb-3">
                    <div class="metric-card metric-card--total">
                        <div class="metric-card__body">
                            <div class="metric-card__header">
                                <span class="metric-card__title">Total Logs</span>
                                <div class="metric-card__icon-box">
                                    <i class="fa-solid fa-chart-line"></i>
                                </div>
                            </div>
                            <div class="metric-card__value">{{metrics.total}}</div>
                        </div>
                    </div>
                </div>

                <div class="col-xl-2 col-lg-4 col-md-4 col-sm-6 mb-3">
                    <div class="metric-card metric-card--auth">
                        <div class="metric-card__body">
                            <div class="metric-card__header">
                                <span class="metric-card__title">Authentication</span>
                                <div class="metric-card__icon-box">
                                    <i class="fa-solid fa-shield-halved"></i>
                                </div>
                            </div>
                            <div class="metric-card__value">{{metrics.auth}}</div>
                        </div>
                    </div>
                </div>

                <div class="col-xl-2 col-lg-4 col-md-4 col-sm-6 mb-3">
                    <div class="metric-card metric-card--books">
                        <div class="metric-card__body">
                            <div class="metric-card__header">
                                <span class="metric-card__title">Books</span>
                                <div class="metric-card__icon-box">
                                    <i class="fa-solid fa-book-open"></i>
                                </div>
                            </div>
                            <div class="metric-card__value">{{metrics.books}}</div>
                        </div>
                    </div>
                </div>

                <div class="col-xl-2 col-lg-4 col-md-4 col-sm-6 mb-3">
                    <div class="metric-card metric-card--users">
                        <div class="metric-card__body">
                            <div class="metric-card__header">
                                <span class="metric-card__title">Users</span>
                                <div class="metric-card__icon-box">
                                    <i class="fa-solid fa-user-group"></i>
                                </div>
                            </div>
                            <div class="metric-card__value">{{metrics.users}}</div>
                        </div>
                    </div>
                </div>

                <div class="col-xl-2 col-lg-4 col-md-4 col-sm-6 mb-3">
                    <div class="metric-card metric-card--attendance">
                        <div class="metric-card__body">
                            <div class="metric-card__header">
                                <span class="metric-card__title">Attendance</span>
                                <div class="metric-card__icon-box">
                                    <i class="fa-solid fa-user-check"></i>
                                </div>
                            </div>
                            <div class="metric-card__value">{{metrics.attendance}}</div>
                        </div>
                    </div>
                </div>

                <div class="col-xl-2 col-lg-4 col-md-4 col-sm-6 mb-3">
                    <div class="metric-card metric-card--system">
                        <div class="metric-card__body">
                            <div class="metric-card__header">
                                <span class="metric-card__title">System</span>
                                <div class="metric-card__icon-box">
                                    <i class="fa-solid fa-server"></i>
                                </div>
                            </div>
                            <div class="metric-card__value">{{metrics.system}}</div>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <div class="activity-logs__filter-card card mb-4">
            <div class="card-body">
                <div class="activity-logs__filter-header mb-3">
                    <h5 class="activity-logs__filter-title mb-1">
                        <i class="fa-solid fa-filter mr-1"></i> Filter & Search Logs
                    </h5>
                    <p class="activity-logs__filter-subtitle mb-0">
                        Filter activity logs by category or search for specific events
                    </p>
                </div>
                <form action="/admin/logs" method="GET" class="activity-logs__filter-form">
                    <div class="row align-items-center">
                        <div class="col-lg-8 col-md-7 mb-2 mb-md-0">
                            <div class="input-group activity-logs__search-box">
                                <div class="input-group-prepend">
                                    <span class="input-group-text bg-transparent border-right-0">
                                        <i class="fa-solid fa-magnifying-glass text-muted"></i>
                                    </span>
                                </div>
                                <input type="text" name="search" class="form-control border-left-0"
                                    placeholder="Search logs by user, action, or details..." value="{{filters.search}}">
                            </div>
                        </div>

                        <div class="col-lg-4 col-md-5">
                            <select name="category" class="custom-select activity-logs__select"
                                onchange="this.form.submit()">
                                {{#each categoryOptions}}
                                <option value="{{this.value}}" {{#if this.isSelected}}selected{{/if}}>
                                    {{this.label}}
                                </option>
                                {{/each}}
                            </select>
                        </div>
                    </div>
                </form>
            </div>
        </div>

        <div class="activity-logs__feed-header d-flex justify-content-between align-items-center mb-3">
            <h4 class="activity-logs__feed-title mb-0 d-flex align-items-center">
                <i class="fa-solid fa-chart-line mr-2"></i>
                Activity Log
            </h4>
            <span class="activity-logs__feed-count">
                Showing {{showingCount}} of {{totalLogsCount}} log entries
            </span>
        </div>

        <div class="activity-logs__feed-list">
            {{#if logs.length}}
            {{#each logs}}
            <div class="log-item mb-3">
                <div class="log-item__body">
                    <div class="log-item__row">
                        <div class="log-item__icon-col">
                            <div class="log-item__icon-box log-item__icon-box--{{this.badgeModifier}}">
                                <i class="fa-solid {{this.icon}}"></i>
                            </div>
                        </div>

                        <div class="log-item__content-col">
                            <div class="d-flex flex-wrap justify-content-between align-items-start mb-1">
                                <h5 class="log-item__action-title mb-1 font-weight-bold">
                                    {{this.action}}
                                </h5>
                                <div class="d-flex align-items-center">
                                    <span class="log-item__badge log-item__badge--{{this.badgeModifier}}">
                                        {{this.categoryLabel}}
                                    </span>
                                    <span class="log-item__time ml-3">
                                        <i class="fa-regular fa-clock mr-1"></i>
                                        {{this.formattedTime}}
                                    </span>
                                </div>
                            </div>

                            <p class="log-item__desc mb-2">
                                {{this.description}}
                            </p>

                            <div class="log-item__actor-box">
                                <div class="log-item__actor-label text-primary">
                                    <i class="fa-solid fa-user mr-1"></i> User
                                </div>
                                <div class="log-item__actor-name font-weight-bold">
                                    {{this.actorDisplayText}}
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
            {{/each}}
            {{else}}
            <div class="activity-logs__empty text-center py-5">
                <div class="activity-logs__empty-icon mb-3">
                    <i class="fa-solid fa-magnifying-glass fa-3x text-muted"></i>
                </div>
                <h5 class="font-weight-bold text-secondary">No activity logs found</h5>
                <p class="text-muted mb-3">There are no records matching your current filter criteria.</p>
                <a href="/admin/logs" class="btn btn-outline-primary btn-sm">
                    <i class="fa-solid fa-rotate-left mr-1"></i> Clear Filters
                </a>
            </div>
            {{/if}}
        </div>
    </div>
</div>