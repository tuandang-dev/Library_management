<div class="cart-page">
    <div class="cart-header d-flex justify-content-between align-items-start mb-4">
        <div>
            <h1 class="cart-header__title d-flex align-items-center gap-2">
                <i class="fa-solid fa-cart-shopping cart-header__icon mr-2"></i>
                <span>My Cart</span>
            </h1>
            <p class="cart-header__desc">Review and checkout your selected items.</p>
        </div>
        <div class="cart-header__badge">
            <i class="fa-solid fa-cart-shopping me-1 mr-2"></i>
            <span id="headerCartCount">{{cartCount}} total items</span>
        </div>
    </div>

    {{#if cart.length}}
    <div class="checkout-summary mb-4">
        <h2 class="checkout-summary__title">Checkout Summary</h2>
        <p class="checkout-summary__desc" id="summaryItemsDesc">
            {{cartCount}} book(s) and 0 equipment item(s) selected for borrowing
        </p>

        <div class="checkout-summary__due-box mb-3">
            <div class="d-flex align-items-center gap-2">
                <i class="fa-regular fa-calendar-check checkout-summary__due-icon"></i>
                <span class="checkout-summary__due-label">Expected return date (books):</span>
            </div>
            <span class="checkout-summary__due-date">{{expectedReturnDate}}</span>
        </div>

        <div class="checkout-summary__actions flex align-items-center gap-3">
            <button type="button" class="checkout-summary__btn-checkout flex-grow-1" id="btnCheckoutQR">
                <span>Checkout All Items & Generate QR</span>
            </button>
            <button type="button" class="checkout-summary__btn-clear" id="btnClearCart">
                Clear Cart
            </button>
        </div>
    </div>

    <div class="selected-items">
        <h2 class="selected-items__title mb-3">Selected Items</h2>

        <div class="selected-items__list gap-3" id="cartItemsList">
            {{#each cart}}
            <div class="cart-item" data-book-id="{{this.bookId}}">
                <div class="cart-item__main d-flex align-items-start gap-3">
                    <div class="cart-item__icon-wrap">
                        <i class="fa-solid fa-book-open"></i>
                    </div>
                    <div class="cart-item__details">
                        <h3 class="cart-item__title">{{this.title}}</h3>
                        <p class="cart-item__author">by {{this.author}}</p>
                        <div class="cart-item__meta d-flex flex-wrap align-items-center gap-3">
                            <span class="cart-item__meta-item">
                                <span>ISBN:</span> {{this.isbn}}
                            </span>
                            <span class="cart-item__meta-item">
                                <span>Category:</span> {{this.category}}
                            </span>
                            <span class="cart-item__meta-item">
                                <span>Location:</span> {{this.location}}
                            </span>
                        </div>
                    </div>
                </div>
                <button type="button" class="cart-item__btn-remove btn-remove-item" data-id="{{this.bookId}}"
                    title="Remove from cart">
                    <i class="fa-regular fa-trash-can"></i>
                </button>
            </div>
            {{/each}}
        </div>
    </div>
    {{else}}
    <div class="cart-empty text-center py-5">
        <div class="cart-empty__icon-wrap mb-3">
            <i class="fa-solid fa-cart-shopping"></i>
        </div>
        <h2 class="cart-empty__title">Your cart is empty</h2>
        <p class="cart-empty__desc mb-4">Browse our book collection and add items to your cart for borrowing.</p>
    </div>
    {{/if}}
</div>

<dialog id="ticketModal" class="ticket-modal">
    <div class="ticket-modal__content">
        <button type="button" class="ticket-modal__close-btn" id="closeTicketModalBtn" aria-label="Close dialog">
            <i class="fa-solid fa-xmark"></i>
        </button>

        <div class="ticket-modal__header text-center">
            <div class="ticket-modal__icon-badge mb-2">
                <i class="fa-solid fa-qrcode"></i>
            </div>
            <h2 class="ticket-modal__title">Book Checkout Ticket</h2>
            <p class="ticket-modal__desc">Present this QR code to the librarian to complete your checkout</p>
        </div>

        <div class="ticket-modal__qr-wrap">
            <img src="" alt="Borrow QR Code" class="ticket-modal__qr-img" id="ticketQrImage">
        </div>

        <div class="ticket-modal__summary-bar d-flex justify-content-between align-items-center mb-3">
            <div class="d-flex align-items-center gap-2 ticket-modal__item-left">
                <span class="ticket-modal__summary-icon">
                    <i class="fa-solid fa-cart-shopping ticket-modal__item-idx"></i>
                </span>
                <span class="ticket-modal__summary-text">Checked Out Items</span>
            </div>
            <span class="ticket-modal__summary-badge" id="ticketSummaryTotal">0 Total</span>
        </div>

        <div class="ticket-modal__items-section mb-3">
            <h3 class="ticket-modal__items-title d-flex align-items-center gap-2 mb-2">
                <i class="fa-solid fa-book-open"></i>
                <span id="ticketBooksHeading">Books (0)</span>
            </h3>
            <div class="ticket-modal__items-list d-flex flex-column gap-2" id="ticketItemsList"></div>
        </div>

        <div class="ticket-modal__details-card mb-4">
            <div class="ticket-modal__details-row d-flex justify-content-between align-items-center mb-2">
                <div class="d-flex flex-column align-items-center">
                    <span class="ticket-modal__field-label">Ticket ID</span>
                    <span class="ticket-modal__field-val" id="ticketIdVal">TKT-XXXXXXXX</span>
                </div>
                <div class="d-flex flex-column align-items-center text-end">
                    <span class="ticket-modal__field-label">Status</span>
                    <span class="ticket-modal__status-badge ticket-modal__status-badge--active"
                        id="ticketStatusVal">ACTIVE</span>
                </div>
            </div>
            <div
                class="ticket-modal__timestamps d-flex flex-column gap-1 pt-2 justify-content-center align-items-center">
                <div class="ticket-modal__time-item">
                    <i class="fa-regular fa-clock"></i>
                    <span>Generated: </span>
                    <strong id="ticketGeneratedAt">-</strong>
                </div>
                <div class="ticket-modal__time-item">
                    <i class="fa-regular fa-clock"></i>
                    <span>Expires: </span>
                    <strong id="ticketExpiresAt">-</strong>
                </div>
            </div>
        </div>

        <button type="button" class="ticket-modal__btn-complete" id="btnCompleteClose">
            <i class="fa-regular fa-circle-check me-2 mr-2"></i>
            <span>Complete & Close</span>
        </button>
    </div>
</dialog>

<script>
    document.addEventListener('DOMContentLoaded', () => {
        const removeBtns = document.querySelectorAll('.btn-remove-item');
        removeBtns.forEach(btn => {
            btn.addEventListener('click', async (e) => {
                e.preventDefault();
                const bookId = btn.dataset.id;

                try {
                    const response = await fetch('/cart/remove', {
                        method: 'POST',
                        headers: { 'Content-Type': 'application/json' },
                        body: JSON.stringify({ bookId })
                    });

                    const result = await response.json();
                    if (result.success) {
                        if (result.cartCount === 0) {
                            window.location.reload();
                        } else {
                            const itemCard = document.querySelector(`.cart-item[data-book-id="${bookId}"]`);
                            if (itemCard) itemCard.remove();

                            const headerCount = document.getElementById('headerCartCount');
                            const summaryDesc = document.getElementById('summaryItemsDesc');
                            if (headerCount) headerCount.textContent = `${result.cartCount} total items`;
                            if (summaryDesc) summaryDesc.textContent = `${result.cartCount} book(s) and 0 equipment item(s) selected for borrowing`;

                            const headerCartBadge = document.getElementById('headerCartBadge');
                            if (headerCartBadge) {
                                if (result.cartCount > 0) {
                                    headerCartBadge.textContent = result.cartCount;
                                    headerCartBadge.style.display = 'flex';
                                } else {
                                    headerCartBadge.style.display = 'none';
                                }
                            }
                        }
                    }
                } catch (err) {
                    console.error('Lỗi khi xóa mục giỏ hàng:', err);
                    alert('Có lỗi xảy ra khi kết nối máy chủ!');
                }
            });
        });

        const clearCartBtn = document.getElementById('btnClearCart');
        if (clearCartBtn) {
            clearCartBtn.addEventListener('click', async () => {
                if (!confirm('Bạn có chắc chắn muốn xóa toàn bộ sách trong giỏ mượn?')) return;

                try {
                    const response = await fetch('/cart/clear', {
                        method: 'POST',
                        headers: { 'Content-Type': 'application/json' }
                    });

                    const result = await response.json();
                    if (result.success) {
                        window.location.reload();
                    } else {
                        alert(result.message || 'Không thể làm trống giỏ!');
                    }
                } catch (err) {
                    console.error('Lỗi khi dọn giỏ:', err);
                    alert('Có lỗi xảy ra khi kết nối máy chủ!');
                }
            });
        }

        const ticketModal = document.getElementById('ticketModal');
        const btnCheckoutQR = document.getElementById('btnCheckoutQR');
        const closeTicketModalBtn = document.getElementById('closeTicketModalBtn');
        const btnCompleteClose = document.getElementById('btnCompleteClose');

        let currentTicketId = '';

        if (btnCheckoutQR) {
            btnCheckoutQR.addEventListener('click', async () => {
                try {
                    btnCheckoutQR.disabled = true;
                    btnCheckoutQR.innerHTML = '<i class="fa-solid fa-spinner fa-spin me-2"></i> Generating Ticket...';

                    const response = await fetch('/cart/checkout', {
                        method: 'POST',
                        headers: { 'Content-Type': 'application/json' }
                    });

                    const data = await response.json();
                    if (data.success && data.ticket) {
                        const { ticket } = data;
                        currentTicketId = ticket.ticketId;

                        document.getElementById('ticketQrImage').src = ticket.qrCodeDataUrl;
                        document.getElementById('ticketSummaryTotal').textContent = `${ticket.totalItems} Total`;
                        document.getElementById('ticketBooksHeading').textContent = `Books (${ticket.totalItems})`;
                        document.getElementById('ticketIdVal').textContent = ticket.ticketId;
                        document.getElementById('ticketStatusVal').textContent = ticket.status;
                        document.getElementById('ticketGeneratedAt').textContent = ticket.generatedAtFormatted;
                        document.getElementById('ticketExpiresAt').textContent = ticket.expiresAtFormatted;

                        const itemsContainer = document.getElementById('ticketItemsList');
                        itemsContainer.innerHTML = '';
                        ticket.items.forEach((item, index) => {
                            const itemElement = document.createElement('div');
                            itemElement.className = 'ticket-modal__item';
                            itemElement.innerHTML = `
                            <div class="ticket-modal__item-left">
                                <span class="ticket-modal__item-idx">${index + 1}</span>
                                <div>
                                    <h4 class="ticket-modal__item-title">${item.title}</h4>
                                    <p class="ticket-modal__item-author">by ${item.author}</p>
                                </div>
                            </div>
                            <span class="ticket-modal__item-tag">Book</span>
                        `;
                            itemsContainer.appendChild(itemElement);
                        });

                        ticketModal.showModal();
                    } else {
                        alert(data.message || 'Không thể tạo vé mượn sách!');
                    }
                } catch (err) {
                    console.error('Lỗi khi checkout:', err);
                    alert('Có lỗi xảy ra khi tạo vé mượn sách!');
                } finally {
                    btnCheckoutQR.disabled = false;
                    btnCheckoutQR.innerHTML = '<i class="fa-solid fa-qrcode me-2"></i><span>Checkout All Items & Generate QR</span>';
                }
            });
        }

        if (btnCompleteClose) {
            btnCompleteClose.addEventListener('click', async () => {
                try {
                    btnCompleteClose.disabled = true;
                    btnCompleteClose.innerHTML = '<i class="fa-solid fa-spinner fa-spin me-2"></i> Processing...';

                    const response = await fetch('/cart/clear', {
                        method: 'POST',
                        headers: { 'Content-Type': 'application/json' }
                    });

                    const result = await response.json();
                    if (result.success) {
                        ticketModal.close();
                        window.location.href = `/cart/ticket/${currentTicketId}`;
                    } else {
                        alert(result.message || 'Không thể dọn sạch giỏ hàng!');
                    }
                } catch (err) {
                    console.error('Lỗi khi hoàn tất đơn mượn:', err);
                    alert('Có lỗi xảy ra khi hoàn tất đơn mượn!');
                } finally {
                    btnCompleteClose.disabled = false;
                }
            });
        }
    });
</script>