<div class="auth-page">
    <div class="card auth-card">

        <div class="card__header auth-card__header">
            <img src="/img/logo-small.png" alt="UCC Library" class="auth-card__logo">
            <h1 class="auth-card__title">Reset Password</h1>
            <p class="auth-card__subtitle">Enter your email address to receive a verification code</p>
        </div>

        <div class="card__body">
            <form action="/forgot-password" method="POST" class="auth-form">
                {{> input type="email" id="email" name="email" label="Email Address"
                placeholder="Enter your email address" required=true }}

                {{> button type="submit" text="Send Verification Code" modifier="btn--primary btn--block" }}
            </form>

            {{#if (error)}}
            <div class="Notification">{{errorMessage}}</div>
            {{else}}
            <div class="Notification">{{successMessage}}</div>
            {{/if}}

            {{#if errorMessage}}
            <div>{{errorMessage}}</div>
            {{/if}}

            <div class="auth-card__links">
                <a href="/login" class="auth-card__link">Back to Login</a>
            </div>
        </div>
    </div>
</div>